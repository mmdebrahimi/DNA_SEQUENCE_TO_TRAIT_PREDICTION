@echo off
REM GENERATED by scripts/detached_launch.py -- edit the generator, not this file.
REM The long-horizon fine-tune for `finetuned-promoteratlas-encoder-150bp`.
REM Generated 2026-11-03 for the 2026-11-04 to 2026-11-13 unattended window.
REM 
REM IT WAITS FOR THE HEADS RUN, SO IT CAN BE LAUNCHED NOW. Two concurrent torch jobs
REM is this host's documented access-violation hazard, and four CPU threads shared
REM between them halves both. The wait is encoded rather than left as an
REM instruction, because needing someone present at the handover is exactly the
REM constraint this plan is built around. On timeout it proceeds and says so in the
REM log: a run that never starts wastes the whole window.
REM 
REM ROUTE IS LOCAL BY DERIVATION, NOT BY PREFERENCE. The probe routed this arm to
REM Kaggle against a fixed 6 h ceiling whose own stated justification is
REM operational -- that a multi-day local run tends to be abandoned part-way. An
REM authorised ten-day window falsifies that premise, so the frozen bar derives the
REM ceiling from the window instead: 216 h x 0.60 committable = 129.6 h, which the
REM measured 23.82 h local projection fits. The 0.60 comes from this host's measured
REM 34% throughput swing, which alone permits at most 0.746, with the rest paying
REM for an unattended reboot. Kaggle was also unavailable on its own terms: it needs
REM an invocation to retrieve its output and nothing will invoke me for ten days.
REM 
REM ONE RUN, CARRIED LONG. Training is deterministic given a seed, so a single run
REM recording every epoch contains the frozen 7-epoch budget's verdict as a PREFIX
REM of the same trajectory. Three runs at E, 2E and 4E epochs would spend 7E epochs
REM per seed for strictly less information. Epochs beyond the budget are
REM PRE-DECLARED INELIGIBLE diagnostics whose only purpose is closing the
REM budget-limited reading empirically rather than by inference from a 2,160-tile
REM subsample curve.
REM 
REM BOTH ROOTS ARE ON C:, AND THE SECOND IS NOT OPTIONAL. MPRA_CACHE defaults to
REM D:/dna_decode_cache/mpra and D: is NOT attached -- disk 1 is an empty card
REM reader. The heads run died in one second on exactly this before it was set.
REM Without it this run would die in one second after the user has left. The C: copy
REM was verified by CONTENT, not by name: load_arm_cohort refuses any count other
REM than 44,106 because the embedding cache is positional.
REM 
REM RESUMABLE, WHICH A TEN-DAY RUN ON THIS HOST NEEDS. Each epoch's shuffle is
REM seeded by (seed, epoch) alone, never by accumulated RNG, so a resumed run
REM reproduces an uninterrupted one bit for bit. The per-seed checkpoint carries
REM encoder, head, optimiser and curve and is rewritten every epoch, so a death
REM costs one epoch; finished seeds are read, never recomputed. A Windows Update
REM reboot inside ten days is plausible and nothing restarts this automatically --
REM on return it may need one relaunch, which resumes.
REM 
REM THE WALL CLOCK IS HARD. At the deadline it stops at an epoch boundary and stamps
REM BOUNDED_BY_WALL_CLOCK, never COMPLETE, because overrunning leaves every seed
REM half-done.
REM 
REM READ THE STATE WITH: python scripts/detached_launch.py status
REM
REM Launch DETACHED from PowerShell so it outlives the session:
REM   Start-Process -FilePath <repo>\run_finetune_arm_detached.bat -WorkingDirectory <repo> -WindowStyle Hidden

setlocal
cd /d "%~dp0"

set "LOG=%~dp0data\unattended\finetune_arm.log"
set "SENTINEL=%~dp0data\unattended\finetune_arm.sentinel"
set "LOCK=%~dp0data\unattended\finetune_arm.lock"

REM A sentinel from a PREVIOUS run must go before this one starts: a stale EXIT=0 left
REM beside a live job reads as COMPLETE and would hide the run entirely.
if exist "%SENTINEL%" del "%SENTINEL%"

REM Unbuffered, or a death loses the last minutes of the log -- which is precisely the
REM window that explains the death.
set PYTHONUNBUFFERED=1

REM Job environment, set inside setlocal so it cannot leak to the caller.
REM PA_REPO and friends are read at module import, so a runtime argument
REM could not reach them.
set "MPRA_CACHE=C:\Users\Laptop Portable\pythonprojects\dna_decode\data\mpra"
set "PA_REPO=C:\Users\Laptop Portable\pythonprojects\dna_decode\data\pa_clone_durable"

echo ==== start %DATE% %TIME% ==== > "%LOG%"

REM WAIT FOR THE OTHER TORCH JOB TO CLEAR BEFORE STARTING.
REM Two concurrent torch jobs is this host's documented access-violation hazard, and
REM four CPU threads shared between them halves both. The run lock cannot express
REM this -- separate jobs hold separate locks, and sharing one would make this run
REM REFUSE rather than defer, turning a scheduling problem into a run that never
REM happens. Encoding the order here means this launcher can be started immediately
REM and begins by itself, instead of needing someone present at the handover.
REM On timeout it proceeds anyway and says so in the log: a run that never starts
REM wastes the whole window, which is the scarcer resource.
uv run python scripts/detached_launch.py wait-for expression_heads --timeout 43200 >> "%LOG%" 2>&1

REM Guarded by the PID-bearing run lock: a second launch over a long window exits 9
REM rather than running two concurrent torch jobs, which is this host's documented
REM access-violation hazard. `run` (not `acquire`) holds the lock for the CHILD's
REM lifetime -- an `acquire` process exits at once and its pid is reclaimed as stale.
uv run python scripts/glm_run_lock.py run "%LOCK%" --label "finetune_arm" -- uv run python -m scripts.finetune_arm_run >> "%LOG%" 2>&1

set "RC=%ERRORLEVEL%"

echo ==== end %DATE% %TIME% rc=%RC% ==== >> "%LOG%"

REM THE REDIRECT IS WRITTEN BEFORE THE ECHO ON PURPOSE. `echo EXIT=%RC%>>file` expands
REM to `echo EXIT=0>>file`, and cmd reads a digit immediately preceding `>>` as a FILE
REM HANDLE -- it redirects handle 0 (stdin) and leaves the sentinel EMPTY. Measured on
REM run_glm_anchor_detached.bat, not theorised.
>>"%SENTINEL%" echo EXIT=%RC%

endlocal
exit /b %RC%
