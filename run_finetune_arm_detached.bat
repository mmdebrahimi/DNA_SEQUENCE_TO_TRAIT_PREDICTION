@echo off
REM GENERATED by scripts/detached_launch.py -- edit the generator, not this file.
REM The long-horizon fine-tune for `finetuned-promoteratlas-encoder-150bp`.
REM Regenerated 2026-11-04 after a review found the first sizing wrong by 28%.
REM 
REM SIZED FROM A MEASURED EPOCH COST, NOT A PROJECTION. The probe's
REM seconds_per_epoch is n_train/throughput -- TRAINING ONLY. Every epoch also
REM validates 11,198 sequences, timed on the real cohort at 342.9 s against
REM 1,225.2 s of training. So the real per-epoch cost is 1,568.1 s and the first
REM plan's 381 epochs were 166.0 h against a 129.6 h ceiling. Horizon is now 27
REM epochs per seed: 291 epochs, 126.8 h, 2.85 h of margin.
REM 
REM THE NULLS RUN BEFORE THE INELIGIBLE TAIL, and that ordering is the point. The
REM three shuffled-label null replicates are a GATE in the frozen bar. Running them
REM last meant a wall-clock stop cut exactly the thing a verdict requires -- ~130
REM hours of correct training and no verdict. Now: every seed to the frozen 7-epoch
REM budget, then the nulls, then extend toward 27. The verdict is secured at about
REM 40 h; a stop after that costs only pre-declared INELIGIBLE diagnostics.
REM 
REM THE REORDERING IS FREE because each epoch's shuffle is a pure function of
REM (seed, epoch), so 7-then-27 is bit-identical to straight-to-27. Pinned by test.
REM 
REM THE FROZEN BAR IS NOT EDITED. Its horizon field says 38, which is unreachable
REM (its sizing reserved nothing for the nulls; at the measured cost that is 174.7 h,
REM 45 h over its own ceiling). The horizon governs only the ineligible tail and the
REM verdict reads the frozen 7-epoch prefix, so overriding it at launch cannot move
REM the arm's result -- whereas editing the frozen artifact is a different act and is
REM the user's call. The divergence is recorded in the run artifact.
REM 
REM MEMORY FIX VERIFIED AT REAL SCALE. The first launch died in four minutes
REM allocating 8.06 GB: the validation forward pass was unbatched, so attention over
REM 11,198 sequences at 8 heads x 150 x 150 is 7.94 GB in one tensor. Validation now
REM runs in 512-sequence chunks (~369 MB peak) and a real full-scale pass completed
REM with all 11,198 predictions finite.
REM 
REM BOTH ROOTS ON C:, AND MPRA_CACHE IS NOT OPTIONAL. Its default is
REM D:/dna_decode_cache/mpra and D: is an empty card reader. The heads run died in
REM one second on exactly this before it was set.
REM 
REM RESUMABLE, WHICH THIS HOST NEEDS. The host hard-shut-down twice on 2026-11-03
REM (Kernel-Power 41; cause was a wrong charger wire, since fixed). Per-seed
REM checkpoints are rewritten every epoch and resume is bit-for-bit exact, so a power
REM cut costs one epoch. Finished seeds are read, never recomputed. Nothing restarts
REM this automatically -- on return it may need one relaunch, which resumes.
REM 
REM READ THE STATE WITH: python scripts/detached_launch.py status
REM
REM Launch DETACHED from PowerShell so it outlives the session:
REM   Start-Process -FilePath <repo>\run_finetune_arm_detached.bat -WorkingDirectory <repo> -WindowStyle Hidden

setlocal
cd /d "%~dp0"

set "LOG=%~dp0data\unattended\finetune_arm.log"
set "SENTINEL=%~dp0data\unattended\finetune_arm.sentinel"
set "LOCK=%~dp0data\unattended\finetune_arm.lock"

REM A sentinel from a PREVIOUS run must go before this one starts: a stale EXIT=0 left
REM beside a live job reads as COMPLETE and would hide the run entirely.
if exist "%SENTINEL%" del "%SENTINEL%"

REM Unbuffered, or a death loses the last minutes of the log -- which is precisely the
REM window that explains the death.
set PYTHONUNBUFFERED=1

REM Job environment, set inside setlocal so it cannot leak to the caller.
REM PA_REPO and friends are read at module import, so a runtime argument
REM could not reach them.
set "MPRA_CACHE=C:\Users\Laptop Portable\pythonprojects\dna_decode\data\mpra"
set "PA_REPO=C:\Users\Laptop Portable\pythonprojects\dna_decode\data\pa_clone_durable"

echo ==== start %DATE% %TIME% ==== > "%LOG%"

REM Guarded by the PID-bearing run lock: a second launch over a long window exits 9
REM rather than running two concurrent torch jobs, which is this host's documented
REM access-violation hazard. `run` (not `acquire`) holds the lock for the CHILD's
REM lifetime -- an `acquire` process exits at once and its pid is reclaimed as stale.
uv run python scripts/glm_run_lock.py run "%LOCK%" --label "finetune_arm" -- uv run python -m scripts.finetune_arm_run --horizon 27 --seconds-per-epoch 1568.1 >> "%LOG%" 2>&1

set "RC=%ERRORLEVEL%"

echo ==== end %DATE% %TIME% rc=%RC% ==== >> "%LOG%"

REM THE REDIRECT IS WRITTEN BEFORE THE ECHO ON PURPOSE. `echo EXIT=%RC%>>file` expands
REM to `echo EXIT=0>>file`, and cmd reads a digit immediately preceding `>>` as a FILE
REM HANDLE -- it redirects handle 0 (stdin) and leaves the sentinel EMPTY. Measured on
REM run_glm_anchor_detached.bat, not theorised.
>>"%SENTINEL%" echo EXIT=%RC%

endlocal
exit /b %RC%
