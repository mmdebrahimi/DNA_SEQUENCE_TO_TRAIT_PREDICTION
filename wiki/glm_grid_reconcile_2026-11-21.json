  "date": "2026-11-21",
  "question": "Do the seed-role probes reproduce the grid they were scored against, and what is the winnable region when the floor is measured in the NULL's own geometry?",
  "geometry": {
    "window_length_bp": 150,
    "limit_natural": 1200,
    "n_generated_per_candidate": 120,
    "natural_set_arg": "promoter",
    "kmer_k": 4,
    "positional_bins": 6,
    "markov_order": 3,
    "feature_modes": [
      "kmer",
      "both"
    ],
    "source": "scripts/kaggle/glm_paired_sweep_kernel.py:45 RECORDED"
  },
  "the_defect_this_found": {
    "what": "Both seed-role probes used n_generated=400; the committed kernel froze n=120.",
    "consequence": "The all-coupled arm claimed to reproduce the status quo and did not. At n=400 it reports `both` sd 0.0140; the grid's own ten nulls have sd 0.0410, so the arm it was compared against was never the status quo.",
    "detected_by": "reconciling the arm's per-seed values against the grid, which was never done"
  },
  "the_second_defect": {
    "what": "`margin = null - ceiling` subtracted a 600-vs-120 AUROC from a 300-vs-300 one.",
    "why_it_matters": "A held-out AUROC's sampling variation depends on test-set size and class balance, so the two numbers are not commensurable and their difference is not a margin in any geometry.",
    "fix": "score the same eval half against 120 REAL held-out natural windows -- the score a PERFECT generator earns at the null's own balance."
  },
  "gate": {
    "reconciled_per_mode": {
      "kmer": 10,
      "both": 10
    },
    "n_seeds": 10,
    "tol": 0.0005,
    "passed": true,
    "meaning": "the hand-written null path is byte-equivalent to the runner's at every seed, so arms built on it describe the committed geometry"
  },
