  "theorem": "If every reaction a knockout disables is either universally blocked (no flux with all exchanges open, hence none in any subset medium) or duplicate-rescued by a surviving reaction with a covering canonical interval, the knockout leaves the feasible set over the retained reactions unchanged -- so growth is unchanged for any objective in any medium and the model can never call the gene essential.",
  "needs_fitness_browser_db": false,
  "falsification": {
    "D-Fructose": {
      "wildtype_growth": 0.876997,
      "n_violations": 0,
