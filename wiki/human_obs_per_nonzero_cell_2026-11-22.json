{
  "record": "human-obs-per-nonzero-cell-v1",
  "date": "2026-11-22",
  "requested_by": "P2 Tokenization Axis [f6628f]",
  "spec": "dna-generator-research\\P2-tokenization-axis\\results\\obs-per-nonzero-cell-spec.md -- definition owned by P2, data owned here",
  "question_it_decides": "whether the sparsity cliff that makes the reach question untestable at the count-model class on E. coli also binds on human",
  "NO_VERDICT_ON_THE_ARMS_IS_OFFERED": "the spec reserves that inference to P2. This artifact reports the number, the calibration and the ambiguity, and stops there.",
  "definition_used_verbatim_from_the_spec": {
    "N_obs": "positions where BOTH a k-context and its FOLLOWING BASE are defined; sum of (L-k)",
    "C_k": "distinct observed k-mer contexts",
    "ratio": "N_obs / C_k, PRIMARY per distinct CONTEXT (the row)",
    "secondary_reported_never_substituted": "per (context, next-base) cell",
    "a_correction_made_before_running": "a first draft used (L-k+1) contexts, i.e. every k-mer including the final one, which has no following base. That would have counted a context the conditional cannot use."
  },
  "conventions": {
    "strand": "SINGLE strand as given, identical in calibration and human run",
    "contexts_span_sequence_boundaries": false,
    "N_obs_definition": "sum of (L - k); the final k-mer is excluded as it has no following base",
    "human_geometry": "200 nt element, constant 15 nt adaptors STRIPPED",
    "human_folds": [
      1,
      2,
      3,
      4,
      5,
      6
    ],
    "folds_9_or_10_touched": false
  },
  "CALIBRATION_AND_ITS_ONE_UNRESOLVED_POINT": {
    "why_mandatory": "the spec requires reproducing the E. coli figure with the same code before any human number is reported -- a definition verified only against its own fixture proves nothing about the comparison it exists to make",
    "what_was_run": "five DISJOINT 600-window samples from this repo's E. coli 150 bp corpus, because P2's exact 600 fit windows are not in this tree. The spread across samples bounds the 'not their windows' caveat by measurement.",
