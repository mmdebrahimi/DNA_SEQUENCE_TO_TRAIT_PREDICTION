{
  "record": "glm-corpus-distinct-content-v1",
  "date": "2026-11-21",
  "question": "How much DISTINCT sequence do the cached assemblies hold, as opposed to how many bytes, and what model size does that support?",
  "why": "A pretrain was sized against a 0.92 Gbp raw byte total over a directory where 400 of 459 assemblies are one species. An earlier one-representative-per-species estimate gave ~14.7 Mbp and was flagged as an upper bound with both failure directions named. This measures it instead.",
  "method": {
    "sketch": "FracMinHash (scaled MinHash), the sourmash construction",
    "k": 21,
    "scale": 200,
    "canonical": "min(kmer, reverse_complement(kmer)), so strand does not double-count",
    "hash": "2-bit packing plus a splitmix64 finalizer -- deterministic across processes, unlike CPython's randomised string hash",
    "ambiguity": "sequence is split on any non-ACGT run; no k-mer spans an ambiguity code",
    "estimator": "distinct ~= |sketch| * scale, unbiased because the sample is hash-driven",
    "cap": "12 genomes per species, lexicographic, chosen blind"
  },
  "self_check": {
    "random_sequence_bp": 200000,
    "true_distinct_kmers_approx": 199980,
    "scaled_estimate": 199400,
    "ratio": 0.997,
